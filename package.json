{
  "name": "arocapi-downloader",
  "version": "1.14.7",
  "description": "RO-Crate based collection downloader",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test": "vitest",
    "lint:biome": "biome check .",
    "lint:types": "tsc --noEmit",
    "lint:knip": "knip",
    "docker:build": "docker build -t arocapi-downloader:test .",
    "docker:run": "docker run --rm -p 5173:7000 --env-file .env arocapi-downloader:test",
    "docker:test": "pnpm docker:build && pnpm docker:run"
  },
  "keywords": [
    "ro-crate",
    "downloader",
    "archive"
  ],
  "author": "John Ferlito <johnf@inodes.org>",
  "license": "ISC",
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-ses": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.14",
    "jotai": "^3.0.1",
    "lucide-react": "^1.66.0",
    "nitro": "3.0.261029-rc",
    "p-limit": "^7.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
